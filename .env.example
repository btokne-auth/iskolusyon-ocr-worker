# Copy this file to .env and fill in the real values. Never commit .env.

# Same value as NEXT_PUBLIC_SUPABASE_URL in iskolusyon-backend
SUPABASE_URL=

# Same value as SUPABASE_SERVICE_ROLE_KEY in iskolusyon-backend
SUPABASE_SERVICE_ROLE_KEY=

# A long random password shared with Vercel's OCR_WORKER_SECRET
OCR_WORKER_SECRET=

# Optional. Render sets this itself; locally it defaults to 3001.
# PORT=3001
